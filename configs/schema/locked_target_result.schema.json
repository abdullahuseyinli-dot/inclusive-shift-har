{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inclusive-shift-har:schema:locked-target-result:1.0.0",
  "title": "InclusiveShift-HAR locked target per-seed result",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "record_kind",
    "status",
    "evidence_status",
    "target_opening_number",
    "model_id",
    "seed",
    "split_manifest_sha256",
    "target_seal_id",
    "final_freeze_inventory_sha256",
    "frozen_artifact_set_sha256",
    "opening_receipt_record_sha256",
    "training_configuration_sha256",
    "checkpoint_sha256",
    "calibrator_sha256",
    "class_names",
    "window_count",
    "participant_count",
    "ordered_alignment",
    "prediction_array",
    "participant_level_report",
    "statistical_unit",
    "target_information_used_for_model_selection",
    "record_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_kind": {"const": "locked_target_per_seed_result"},
    "status": {"const": "complete_create_only"},
    "evidence_status": {"const": "locked_confirmatory_target_opening_1"},
    "target_opening_number": {"const": 1},
    "model_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "seed": {"type": "integer", "minimum": 0},
    "split_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "target_seal_id": {"$ref": "#/$defs/sha256"},
    "final_freeze_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "frozen_artifact_set_sha256": {"$ref": "#/$defs/sha256"},
    "opening_receipt_record_sha256": {"$ref": "#/$defs/sha256"},
    "training_configuration_sha256": {"$ref": "#/$defs/sha256"},
    "checkpoint_sha256": {"$ref": "#/$defs/sha256"},
    "calibrator_sha256": {"$ref": "#/$defs/sha256"},
    "class_names": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "window_count": {"type": "integer", "minimum": 1},
    "participant_count": {"type": "integer", "minimum": 1},
    "ordered_alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_ids_sha256",
        "participant_ids_sha256",
        "true_labels_sha256",
        "logits_sha256",
        "uncalibrated_probabilities_sha256",
        "calibrated_probabilities_sha256",
        "predicted_labels_sha256"
      ],
      "properties": {
        "window_ids_sha256": {"$ref": "#/$defs/sha256"},
        "participant_ids_sha256": {"$ref": "#/$defs/sha256"},
        "true_labels_sha256": {"$ref": "#/$defs/sha256"},
        "logits_sha256": {"$ref": "#/$defs/sha256"},
        "uncalibrated_probabilities_sha256": {"$ref": "#/$defs/sha256"},
        "calibrated_probabilities_sha256": {"$ref": "#/$defs/sha256"},
        "predicted_labels_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "prediction_array": {"type": "object"},
    "participant_level_report": {"type": "object"},
    "statistical_unit": {"const": "participant"},
    "target_information_used_for_model_selection": {"const": false},
    "record_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
