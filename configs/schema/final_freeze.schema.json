{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:inclusive-shift-har:schema:final-freeze:1.0.0",
  "title": "InclusiveShift-HAR final source artifact freeze",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "status",
    "evidence_status",
    "created_at_utc",
    "code_commit",
    "dataset_manifest_sha256",
    "source_window_manifest_sha256",
    "split_manifest_sha256",
    "protocol_lock_sha256",
    "target_seal_id",
    "required_seed_order",
    "target_state",
    "models",
    "frozen_artifact_set_sha256",
    "inventory_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_kind": {"const": "final_source_artifact_freeze"},
    "status": {"const": "frozen_before_target_unlock"},
    "evidence_status": {"const": "source_only_final_models_target_sealed"},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "code_commit": {"type": "string", "minLength": 1},
    "dataset_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "source_window_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "split_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "protocol_lock_sha256": {"$ref": "#/$defs/sha256"},
    "target_seal_id": {"$ref": "#/$defs/sha256"},
    "required_seed_order": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "target_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unlock_record",
        "target_subject_or_window_records_loaded",
        "target_predictions_or_performance_accessed"
      ],
      "properties": {
        "unlock_record": {"type": "null"},
        "target_subject_or_window_records_loaded": {"const": false},
        "target_predictions_or_performance_accessed": {"const": false}
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/model"}
    },
    "frozen_artifact_set_sha256": {"$ref": "#/$defs/sha256"},
    "inventory_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safe_relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\).+$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/safe_relative_path"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_id",
        "seed",
        "training_regime",
        "checkpoint_selection_rule",
        "selected_epoch",
        "training_configuration",
        "training_configuration_sha256",
        "checkpoint",
        "calibrator",
        "calibrator_record_sha256"
      ],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "seed": {"type": "integer", "minimum": 0},
        "training_regime": {
          "enum": ["fixed_epoch_neural", "deterministic_classical"]
        },
        "checkpoint_selection_rule": {
          "enum": ["fixed_last_epoch", "source_only_fit_no_epoch_selection"]
        },
        "selected_epoch": {"type": ["integer", "null"], "minimum": 1},
        "training_configuration": {"type": "object"},
        "training_configuration_sha256": {"$ref": "#/$defs/sha256"},
        "checkpoint": {"$ref": "#/$defs/file"},
        "calibrator": {"$ref": "#/$defs/file"},
        "calibrator_record_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
